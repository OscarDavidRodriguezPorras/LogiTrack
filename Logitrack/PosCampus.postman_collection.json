              ],
              "path": [
                "api",
                "producto",
                "{{productoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Galaxy S24 Ultra\",\n  \"marca\": \"Samsung\",\n  \"stock\": 15,\n  \"precioCompra\": 3800000,\n  \"precioVenta\": 4500000\n}",
              "options": {
                "raw": {
                  "language": "json"
