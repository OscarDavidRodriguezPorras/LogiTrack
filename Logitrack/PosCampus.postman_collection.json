            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/detalleventa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "detalleventa"
