    {
      "name": "DetalleVenta",
      "item": [
        {
          "name": "1. Crear detalle de venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/detalleventa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "detalleventa"
              ]
            },
            "description": "Descuenta stock y recalcula el total de la venta. Subtotal = precioVenta x cantidad.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ventaId\": {{ventaId}},\n  \"productoId\": {{productoId}},\n  \"cantidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
