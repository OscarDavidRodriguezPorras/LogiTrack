            ],
            "url": {
              "raw": "{{baseUrl}}/api/producto",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "producto"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Galaxy S24\",\n  \"marca\": \"Samsung\",\n  \"stock\": 20,\n  \"precioCompra\": 2500000,\n  \"precioVenta\": 3200000\n}",
