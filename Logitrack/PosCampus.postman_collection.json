{
  "info": {
    "name": "PosCampus API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Orden recomendado: Producto (1) -> Venta (1) -> DetalleVenta (1..7). Los ids se guardan solos en variables."
